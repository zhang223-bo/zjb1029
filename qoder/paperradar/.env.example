# 复制为 .env 后按需修改；所有项都有默认值，本地演示可以零配置启动
#seekdb（本地 Windows 安装版 / Docker 均可）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DB=paperradar

# PowerContext Server（powercontext server run 启动后可用）
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
# 若启用了认证，填 Server Token
POWERCONTEXT_TOKEN=
# Scope：留空则自动创建/复用名为 paperradar 的 Scope；填 scp_ 开头的 ID 可指定
POWERCONTEXT_SCOPE=paperradar

# 演示用户标识（写入阅读状态记忆）
PAPERRADAR_USER=u_demo

# 检索参数
CHUNK_MAX_CHARS=420
CHUNK_OVERLAP=80
TOP_K=8
